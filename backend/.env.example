# Memora 后端环境变量样例
# 复制为 .env 后修改值，.env 文件不进入 Git

# JWT 密钥（必填，空字符串会导致启动抛错）
# 开发期可用任意随机字符串，生产环境必须用强随机值
# 生成示例：python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=dev-secret-please-change-in-production

# JWT 算法（默认 HS256，一般无需改）
JWT_ALGORITHM=HS256

# JWT 过期天数（默认 7 天）
JWT_EXPIRE_DAYS=7

# 数据库 URL（默认 SQLite 本地文件）
DATABASE_URL=sqlite:///./memora.db
